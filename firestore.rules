rules_version = '2';

// Regras simples para jogar em família: qualquer pessoa com o código de 4 letras
// pode ler e jogar naquela sala. Nada além da coleção "rooms" fica acessível.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if code.size() == 4;
      allow create, update: if code.size() == 4
        && request.resource.data.code == code
        && request.resource.data.players.size() <= 10;
      allow delete: if false;
    }
  }
}
